COOKIE_URL=https://raw.githubusercontent.com/themagmalord333-oss/COOKIE/main/cookies.txt

DDOWNLOAD_DIR=downloads
CACHE_EXPIRE_HOURS=24
MAX_VIDEO_QUALITY=720
PORT=8000

# Maximum complete download jobs running at once
DOWNLOAD_WORKERS=3

# Parallel fragments inside each individual download
CONCURRENT_FRAGMENTS=25

# Keep at 10 MB for YouTube
HTTP_CHUNK_SIZE=10485760